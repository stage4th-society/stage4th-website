---
import { getCollection } from "astro:content";
import { eventSlug, upcomingEvent } from "../../data/events";
import { inlineTokens } from "../../lib/inlineEmphasis.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { copy, languages, siteHero, siteFeatured, siteAbout, siteUpcoming, site, type Lang } from "../../data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
const hero = siteHero[lang];
const featured = siteFeatured[lang];
const about = siteAbout[lang];
const u = siteUpcoming[lang];
const events = await getCollection("events");

// Everything this block shows comes from the featured event's markdown, so
// announcing a new show is a one-file change.
const upcoming = upcomingEvent(events);

const upcomingTitle = upcoming && (lang === "zh" ? upcoming.data.titleZh : upcoming.data.titleEn);
const excerpt = upcoming && (lang === "zh" ? upcoming.data.homeExcerptZh : upcoming.data.homeExcerptEn);
const showtimes = (upcoming && (lang === "zh" ? upcoming.data.showtimesZh : upcoming.data.showtimesEn)) ?? [];
const title = `${site.brand[lang].primary}`;
---

<BaseLayout lang={lang} title={title} description={t.homeIntro}>
  

  <!-- UPCOMING -->
  {upcoming && excerpt && (
    <section class="upcoming">
      <div class="wrap">
        <div class="head">
          <span class="eyebrow">{u.eyebrow}</span>
          <h2 class="display">{u.heading}</h2>
        </div>

        <div class="grid">
          <div class="upcoming-image">
            <img src={upcoming.data.posterImage} alt={upcomingTitle} />
          </div>

          <div class="upcoming-text">
            <h2 class="display"><em>{upcomingTitle}</em></h2>

            {/* One paragraph separated by <br><br>, matching the spacing this
                block has always had — .upcoming-text is a 32px-gap flex column,
                so splitting into real <p> elements would change the rhythm. */}
            <p>
              {excerpt.split("\n\n").map((para, i) => (
                <>
                  {i > 0 && <><br /><br /></>}
                  {inlineTokens(para).map((tok) =>
                    tok.bold && tok.italic ? <strong><em>{tok.text}</em></strong>
                    : tok.bold ? <strong>{tok.text}</strong>
                    : tok.italic ? <em>{tok.text}</em>
                    : tok.text,
                  )}
                </>
              ))}
              {showtimes.length > 0 && <><br /><br /></>}
              {showtimes.map((line, i) => (
                <>{i > 0 && <br />}<strong>{line}</strong></>
              ))}
            </p>

            {upcoming.data.ticketUrl && (
              <a
                class="btn"
                href={upcoming.data.ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {u.cta} <span class="arr">→</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}


  <!-- FEATURED -->
  <section class="featured">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{featured.eyebrow}</span>
      </div>

      <div class="poster-carousel">
        {events.map((event) => (
          <a
            class="archive-poster"
            href={`/${lang}/events/${eventSlug(event)}`}
          >
            <img
              src={event.data.posterImage}
              alt={lang === "en"
                ? event.data.titleEn
                : event.data.titleZh}
            />
          </a>
        ))}
      </div>

      <div class="featured-footer">
        <a class="btn secondary" href={`/${lang}/events`}>
          {lang === "en" ? "Events" : "全部活动"} <span class="arr">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="about">
    <div class="wrap">
      <span class="eyebrow">{lang === "en" ? "About Us" : "关于我们"}</span>
      <p class="pull">
        {about.pull.lead}<br/>
        {about.pull.body}<em class="accent-word">{about.pull.accent}</em>{about.pull.tail}
      </p>

      <p class="lead">{hero.lead}</p>
      
      <div class="pillars">
        {about.pillars.map((p) => (
          <article>
            <span class="n">{p.n}</span>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </article>
        ))}
      </div>
      <a class="btn secondary" href={`/${lang}/about`}>{t.aboutCta} <span class="arr">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .upcoming { padding: 40px 0; border-bottom: 1px solid var(--line); }
  .upcoming .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: 32px; }
  .upcoming h2 em { font-family: "Inter", sans-serif; font-size: clamp(28px, 4vw, 36px); font-style: normal; line-height: 1.15; }
  .upcoming-image { aspect-ratio: 3 / 4; max-height: 800px; width: 100%; overflow: hidden; background: var(--paper-soft); }
  .upcoming-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .upcoming-text { display: flex; flex-direction: column; gap: 32px; max-width: 600px; margin-top: -20px; }
  .upcoming-text p { font-size: 16px; line-height: 1.8; color: var(--ink-soft); }


  .featured { padding: 60px 0; border-bottom: 1px solid var(--line); }
  .featured .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: 32px; }
  .poster-carousel {
    display: flex;
    gap: 16px;

    overflow-x: auto;
    scroll-snap-type: x proximity;

    padding-bottom: 12px;
  }

  .archive-poster {
    flex: 0 0 260px;

    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
  }

  .poster-carousel::-webkit-scrollbar {
    display: none;
  }

  .archive-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-footer {
    display: flex;
    justify-content: start;
    margin-top: 20px;
    padding-top: 20px;
  }
  
  .grid { 
    display: grid; 
    grid-template-columns: 1fr 1.25fr; 
    gap: 64px; 
    padding-right: 100px;
    margin: 40px auto 0; 
    transform: none;
  }
  
  .tape { position: absolute; top: 24px; left: -40px; transform: rotate(-8deg); background: var(--accent); color: var(--ink); font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; padding: 8px 56px; text-transform: uppercase; }
  .info .row { display: grid; grid-template-columns: 110px 1fr; gap: 32px; padding: 22px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .info .row:first-of-type { border-top: 1px solid var(--line); }
  .info .row .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); padding-top: 4px; }
  .info .row strong { font-family: var(--serif); font-weight: 500; font-size: 22px; display: block; }
  .info .row .sub { display: block; font-size: 13px; color: var(--muted); margin-top: 4px; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }


  .about { padding: 40px 0; }
  .about .eyebrow { margin-bottom: 32px; }
  .pull { font-family: var(--serif); font-size: clamp(32px, 3.6vw, 56px); line-height: 1.15; letter-spacing: -0.01em; max-width: 1100px; margin-bottom: 32px; font-style: italic; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin: 60px 0 56px; padding-top: 40px; border-top: 1px solid var(--line); }
  .pillars article { display: flex; flex-direction: column; gap: 12px; }
  .pillars .n { font-family: var(--serif); font-size: 28px; font-style: italic; color: var(--accent-deep); }
  .pillars h3 { font-family: var(--serif); font-weight: 500; font-size: 28px; }
  .pillars p { font-size: 14px; line-height: 1.6; color: var(--ink-soft); }

  
  @media (max-width: 900px) {
    .meta { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    h1.display .l { padding-left: 0 !important; }
    .lead-row { grid-template-columns: 1fr; gap: 24px; }
    .grid { grid-template-columns: 1fr; gap: 40px; padding-right: 0; transform: none;}
    .pillars { grid-template-columns: 1fr; }
    .upcoming-text { margin-top: 0; }
    .upcoming h2 em { font-size: clamp(24px, 3.5vw, 32px); }
    .upcoming-image { 
      max-width: 600px;
      margin: 0 auto;
    }

    .poster-carousel {
      scrollbar-width: thin;              /* Firefox */
      scrollbar-color: var(--line) transparent;
    }

    .poster-carousel::-webkit-scrollbar {
      display: block;
      height: 4px;
    }

    .poster-carousel::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 999px;
    }

    .poster-carousel::-webkit-scrollbar-track {
      background: transparent;
    }
  }

</style>
